+
+
+def _plain_text(fragment: str) -> str:
+    without_tags = re.sub(r"<[^>]+>", " ", fragment)
+    return " ".join(html.unescape(without_tags).split())
+
+
+def test_presentation_contains_approved_18_slide_sequence() -> None:
+    expected_headings = [
