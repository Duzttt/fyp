+class TestLatency:
+    def test_p95_latency_computed(self):
+        queries = [
+            {"id": f"q{i}", "query": f"q{i}", "relevant_chunk_ids": [f"chunk_{i}"]}
+            for i in range(10)
+        ]
+        evaluator = RetrievalEvaluator(queries)
+
+        class SlowRetriever:
+            def retrieve(self, query, top_k=10):
+                time_module.sleep(0.005)
+                return [{"id": query}]
+
