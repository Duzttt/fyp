+        <textarea id="searchQuery" placeholder="输入查询..." style="min-height:50px">What is machine learning?</textarea>
+      </div>
+      <div style="display:flex;gap:8px;align-items:center;margin-bottom:12px">
+        <button class="btn" onclick="runSearch()">搜索</button>
+        <span style="font-size:12px;color:var(--muted)">Top-K:</span>
+        <input type="number" id="topK" value="5" min="1" max="10" style="width:60px;background:var(--surface2);border:1px solid var(--surface2);color:var(--text);padding:4px 8px;border-radius:4px;font-size:13px">
+      </div>
+      <div id="searchResults"></div>
