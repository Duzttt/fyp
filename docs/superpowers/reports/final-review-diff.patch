+        AnswerRelevancyMetric=AnswerRelevancyMetric,
+        ContextualPrecisionMetric=ContextualPrecisionMetric,
+        ContextualRecallMetric=ContextualRecallMetric,
+        ContextualRelevancyMetric=ContextualRelevancyMetric,
+    )
