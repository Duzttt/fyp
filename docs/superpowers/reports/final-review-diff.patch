+    <button class="edit-toggle" id="editToggle" title="Edit mode (E)">Edit</button>
+    <div class="progress-bar" id="progressBar"></div>
+
+    <script>
+        /* ===========================================
+           SLIDE PRESENTATION CONTROLLER
+           =========================================== */
+        class SlidePresentation {
+            constructor() {
+                this.slides = document.querySelectorAll('.slide');
+                this.currentSlide = 0;
+                this.stage = document.getElementById('deckStage');
+                this.progressBar = document.getElementById('progressBar');
+                this.editToggle = document.getElementById('editToggle');
+                this.hotzone = document.querySelector('.edit-hotzone');
+                this.isActive = false;
+                
+                this.setupStageScale();
+                this.setupKeyboardNav();
+                this.setupTouchNav();
+                this.setupInlineEditing();
+                this.showSlide(0);
+            }
+
+            setupStageScale() {
+                const scale = () => {
+                    const factor = Math.min(window.innerWidth / 1920, window.innerHeight / 1080);
+                    const x = (window.innerWidth - 1920 * factor) / 2;
+                    const y = (window.innerHeight - 1080 * factor) / 2;
+                    this.stage.style.transform = `translate(${x}px, ${y}px) scale(${factor})`;
+                };
+                scale();
+                window.addEventListener('resize', scale);
+            }
+
+            setupKeyboardNav() {
+                document.addEventListener('keydown', (e) => {
+                    if (e.target.getAttribute('contenteditable')) return;
+                    
+                    switch(e.key) {
+                        case 'ArrowRight':
+                        case 'ArrowDown':
+                        case ' ':
+                        case 'PageDown':
+                            e.preventDefault();
+                            this.nextSlide();
+                            break;
+                        case 'ArrowLeft':
+                        case 'ArrowUp':
+                        case 'PageUp':
+                            e.preventDefault();
+                            this.prevSlide();
+                            break;
+                        case 'Home':
+                            e.preventDefault();
+                            this.showSlide(0);
+                            break;
+                        case 'End':
+                            e.preventDefault();
+                            this.showSlide(this.slides.length - 1);
+                            break;
+                        case 'e':
+                        case 'E':
+                            this.toggleEditMode();
+                            break;
+                    }
+                });
+            }
+
+            setupTouchNav() {
+                let touchStartX = 0;
+                let touchStartY = 0;
+                
+                document.addEventListener('touchstart', (e) => {
+                    touchStartX = e.touches[0].clientX;
+                    touchStartY = e.touches[0].clientY;
+                });
+                
+                document.addEventListener('touchend', (e) => {
+                    const touchEndX = e.changedTouches[0].clientX;
+                    const touchEndY = e.changedTouches[0].clientY;
+                    const deltaX = touchEndX - touchStartX;
+                    const deltaY = touchEndY - touchStartY;
+                    
+                    if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 50) {
+                        if (deltaX > 0) {
+                            this.prevSlide();
+                        } else {
+                            this.nextSlide();
+                        }
+                    }
+                });
+            }
+
+            setupInlineEditing() {
+                // Hotzone hover with 400ms grace period
+                let hideTimeout = null;
+                
+                this.hotzone.addEventListener('mouseenter', () => {
+                    clearTimeout(hideTimeout);
+                    this.editToggle.classList.add('show');
+                });
+                
+                this.hotzone.addEventListener('mouseleave', () => {
+                    hideTimeout = setTimeout(() => {
+                        if (!this.isActive) this.editToggle.classList.remove('show');
+                    }, 400);
+                });
+                
+                this.editToggle.addEventListener('mouseenter', () => {
+                    clearTimeout(hideTimeout);
+                });
+                
+                this.editToggle.addEventListener('mouseleave', () => {
+                    hideTimeout = setTimeout(() => {
+                        if (!this.isActive) this.editToggle.classList.remove('show');
+                    }, 400);
+                });
+                
+                this.editToggle.addEventListener('click', () => {
+                    this.toggleEditMode();
+                });
+                
+                this.hotzone.addEventListener('click', () => {
+                    this.toggleEditMode();
+                });
+                
+                // Enable contenteditable on text elements
+                this.slides.forEach(slide => {
+                    const textElements = slide.querySelectorAll('h1, h2, h3, p, li, .title, .subtitle, .presenter, .context, .section-title, .section-content, .slide-title');
+                    textElements.forEach(el => {
+                        el.addEventListener('focus', () => {
+                            if (this.isActive) {
+                                el.setAttribute('contenteditable', 'true');
+                            }
+                        });
+                        el.addEventListener('blur', () => {
+                            el.removeAttribute('contenteditable');
+                            this.saveToLocalStorage();
+                        });
+                    });
+                });
+            }
+
+            toggleEditMode() {
+                this.isActive = !this.isActive;
+                document.body.classList.toggle('edit-mode', this.isActive);
+                this.editToggle.classList.toggle('active', this.isActive);
+                this.editToggle.textContent = this.isActive ? 'Save' : 'Edit';
+                
+                if (!this.isActive) {
+                    this.saveToLocalStorage();
+                }
+            }
+
+            saveToLocalStorage() {
+                const slideContents = [];
+                this.slides.forEach((slide, index) => {
+                    const textElements = slide.querySelectorAll('h1, h2, h3, p, li, .title, .subtitle, .presenter, .context, .section-title, .section-content, .slide-title');
+                    const contents = [];
+                    textElements.forEach(el => {
+                        contents.push(el.textContent);
+                    });
+                    slideContents.push(contents);
+                });
+                localStorage.setItem('slideContents', JSON.stringify(slideContents));
+            }
+
+            loadFromLocalStorage() {
+                const saved = localStorage.getItem('slideContents');
+                if (saved) {
+                    const slideContents = JSON.parse(saved);
+                    this.slides.forEach((slide, index) => {
+                        if (slideContents[index]) {
+                            const textElements = slide.querySelectorAll('h1, h2, h3, p, li, .title, .subtitle, .presenter, .context, .section-title, .section-content, .slide-title');
+                            textElements.forEach((el, elIndex) => {
+                                if (slideContents[index][elIndex]) {
+                                    el.textContent = slideContents[index][elIndex];
+                                }
+                            });
+                        }
+                    });
+                }
+            }
+
+            nextSlide() {
+                this.showSlide(this.currentSlide + 1);
+            }
+
+            prevSlide() {
+                this.showSlide(this.currentSlide - 1);
+            }
+
+            showSlide(index) {
+                this.currentSlide = Math.max(0, Math.min(index, this.slides.length - 1));
+                this.slides.forEach((slide, i) => {
+                    slide.classList.toggle('active', i === this.currentSlide);
+                    slide.classList.toggle('visible', i === this.currentSlide);
+                });
+                
+                // Update progress bar
+                const progress = ((this.currentSlide + 1) / this.slides.length) * 100;
+                this.progressBar.style.width = `${progress}%`;
+            }
+        }
+
+        // Initialize presentation
+        const presentation = new SlidePresentation();
+        presentation.loadFromLocalStorage();
+    </script>
+</body>
+</html>
