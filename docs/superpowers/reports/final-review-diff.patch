+        <textarea id="simTextB" placeholder="句子 B">A cat is sitting on a mat</textarea>
+      </div>
+      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
+        <button class="sample-btn" onclick="setSimTexts('The cat sits on the mat','A cat is sitting on a mat')">同义句</button>
+        <button class="sample-btn" onclick="setSimTexts('The cat sits on the mat','Dogs are playing outside')">不相关</button>
+        <button class="sample-btn" onclick="setSimTexts('机器学习是AI的子领域','Machine learning is a subset of AI')">跨语言</button>
+        <button class="sample-btn" onclick="setSimTexts('How does photosynthesis work?','What is the process of photosynthesis?')">问句相似</button>
+      </div>
