+
+<div class="tooltip" id="tooltip" style="display:none"></div>
+
+<script>
+// ========== Data ==========
+const MODELS = [
+  { id: 'minilm', name: 'all-MiniLM-L6-v2', full: 'sentence-transformers/all-MiniLM-L6-v2', dim: 384, speed: 'Fast', memory: '~80MB', mteb: 63.0, best: 'General purpose, default choice', color: '#4ade80' },
+  { id: 'bge-small', name: 'bge-small-en-v1.5', full: 'BAAI/bge-small-en-v1.5', dim: 384, speed: 'Fast', memory: '~90MB', mteb: 62.2, best: 'English retrieval', color: '#38bdf8' },
+  { id: 'bge-large', name: 'bge-large-en-v1.5', full: 'BAAI/bge-large-en-v1.5', dim: 1024, speed: 'Medium', memory: '~330MB', mteb: 64.2, best: 'High accuracy English', color: '#a78bfa' },
+  { id: 'e5-large', name: 'e5-large-v2', full: 'intfloat/e5-large-v2', dim: 1024, speed: 'Medium', memory: '~330MB', mteb: 64.7, best: 'Instruction-aware', color: '#fb923c' },
+  { id: 'qwen3emb', name: 'Qwen3-Embedding-0.6B', full: 'Qwen/Qwen3-Embedding-0.6B', dim: 1024, speed: 'Slow', memory: '~600MB', mteb: 66.0, best: 'Multilingual, highest quality', color: '#f472b6' },
+  { id: 'mpnet', name: 'all-mpnet-base-v2', full: 'sentence-transformers/all-mpnet-base-v2', dim: 768, speed: 'Medium', memory: '~220MB', mteb: 65.0, best: 'Balanced quality/speed', color: '#fbbf24' },
+];
+
+// Simulated document corpus for search demo
+const CORPUS = [
+  { id: 1, text: 'Machine learning is a subset of artificial intelligence that enables systems to learn from data.', topic: 'ML' },
+  { id: 2, text: 'Deep learning uses neural networks with multiple layers to model complex patterns in data.', topic: 'DL' },
+  { id: 3, text: 'Natural language processing allows computers to understand and generate human language.', topic: 'NLP' },
+  { id: 4, text: 'Computer vision enables machines to interpret and understand visual information from images.', topic: 'CV' },
+  { id: 5, text: 'Reinforcement learning trains agents to make decisions by rewarding desired behaviors.', topic: 'RL' },
+  { id: 6, text: 'Transfer learning reuses pre-trained models to solve new but related problems efficiently.', topic: 'TL' },
+  { id: 7, text: 'Supervised learning uses labeled data to train models for classification and regression tasks.', topic: 'ML' },
+  { id: 8, text: 'Unsupervised learning finds hidden patterns in data without using labeled examples.', topic: 'ML' },
+  { id: 9, text: 'The transformer architecture revolutionized NLP with self-attention mechanisms.', topic: 'NLP' },
+  { id: 10, text: 'Generative adversarial networks consist of two neural networks competing against each other.', topic: 'DL' },
+  { id: 11, text: 'Convolutional neural networks are specialized for processing grid-like data such as images.', topic: 'CV' },
+  { id: 12, text: 'Recurrent neural networks process sequential data like text and time series.', topic: 'NLP' },
+];
+
+// Simulated embeddings (pre-computed for demo, 8-dim simplified)
+function seededRandom(seed) {
+  let s = seed;
+  return () => { s = (s * 16807 + 0) % 2147483647; return (s - 1) / 2147483646; };
+}
+
+function generateSimEmbedding(text, dim = 8) {
+  let hash = 0;
+  for (let i = 0; i < text.length; i++) hash = ((hash << 5) - hash + text.charCodeAt(i)) | 0;
+  const rng = seededRandom(Math.abs(hash) + 1);
+  const vec = Array.from({ length: dim }, () => (rng() - 0.5) * 2);
+  // Bias by topic keywords
+  const lower = text.toLowerCase();
+  if (lower.includes('machine') || lower.includes('learning')) vec[0] += 1.5;
+  if (lower.includes('deep') || lower.includes('neural')) vec[1] += 1.5;
+  if (lower.includes('language') || lower.includes('nlp') || lower.includes('text')) vec[2] += 1.5;
+  if (lower.includes('image') || lower.includes('vision') || lower.includes('visual')) vec[3] += 1.5;
+  if (lower.includes('reinforcement') || lower.includes('reward')) vec[4] += 1.5;
+  if (lower.includes('supervised') || lower.includes('labeled')) vec[5] += 1.2;
+  if (lower.includes('unsupervised') || lower.includes('hidden')) vec[6] += 1.2;
+  if (lower.includes('transformer') || lower.includes('attention')) vec[7] += 1.5;
+  // Normalize
+  const norm = Math.sqrt(vec.reduce((s, v) => s + v * v, 0)) || 1;
+  return vec.map(v => v / norm);
+}
+
+function cosineSim(a, b) {
+  let dot = 0, na = 0, nb = 0;
+  for (let i = 0; i < a.length; i++) { dot += a[i]*b[i]; na += a[i]*a[i]; nb += b[i]*b[i]; }
+  return dot / (Math.sqrt(na) * Math.sqrt(nb) + 1e-10);
+}
+
+// Pre-compute corpus embeddings
+const CORPUS_EMB = CORPUS.map(d => ({ ...d, embedding: generateSimEmbedding(d.text) }));
+
+// ========== Tab Switching ==========
+let currentTab = 0;
+function switchTab(idx) {
+  document.querySelectorAll('.tab').forEach((t, i) => t.classList.toggle('active', i === idx));
+  document.querySelectorAll('.panel').forEach((p, i) => p.classList.toggle('active', i === idx));
+  currentTab = idx;
+  if (idx === 4) renderPipeline();
+}
+
+// ========== Tab 0: Model Comparison ==========
+function renderModels() {
+  const grid = document.getElementById('modelGrid');
+  grid.innerHTML = MODELS.map(m => `
+    <div class="model-card" id="mc-${m.id}" onclick="selectModel('${m.id}')">
+      <div class="name">${m.name}</div>
+      <div class="props">
+        <span class="prop dim">${m.dim}D</span>
+        <span class="prop">${m.speed}</span>
+        <span class="prop">${m.memory}</span>
+        <span class="prop">MTEB: ${m.mteb}</span>
+      </div>
+    </div>
+  `).join('');
+
+  const tbody = document.getElementById('modelTable');
+  tbody.innerHTML = MODELS.map(m => `
+    <tr>
+      <td style="color:${m.color};font-weight:600">${m.name}</td>
+      <td>${m.dim}</td>
+      <td>${m.speed}</td>
+      <td>${m.memory}</td>
+      <td><span class="tag ${m.mteb >= 65 ? 'good' : m.mteb >= 63 ? 'warn' : 'bad'}">${m.mteb}</span></td>
+      <td style="color:var(--muted);font-size:12px">${m.best}</td>
+    </tr>
+  `).join('');
+}
+
+function selectModel(id) {
+  document.querySelectorAll('.model-card').forEach(c => c.classList.remove('selected'));
+  document.getElementById(`mc-${id}`).classList.add('selected');
+  const m = MODELS.find(x => x.id === id);
+  document.getElementById('modelDetail').style.display = 'block';
+  document.getElementById('modelDetailTitle').textContent = `${m.full}`;
+  document.getElementById('modelDetailTitle').style.color = m.color;
+
+  // Generate random dim visualization
+  const rng = seededRandom(m.dim);
+  const dims = Array.from({ length: 64 }, () => (rng() - 0.5) * 2);
+  const vis = document.getElementById('dimVis');
+  vis.innerHTML = dims.map(v => {
+    const intensity = Math.abs(v);
+    const color = v > 0 ? `rgba(56,189,248,${0.2 + intensity * 0.8})` : `rgba(248,113,113,${0.2 + intensity * 0.8})`;
+    return `<div class="dim" style="background:${color};height:${10 + intensity * 20}px" title="dim: ${v.toFixed(3)}"></div>`;
+  }).join('');
+
+  document.getElementById('modelStats').innerHTML = `
+    <div style="font-size:13px;line-height:1.8">
+      <div><span style="color:var(--muted)">Full name:</span> ${m.full}</div>
+      <div><span style="color:var(--muted)">Dimension:</span> <span style="color:var(--accent)">${m.dim}</span></div>
+      <div><span style="color:var(--muted)">Speed tier:</span> ${m.speed}</div>
+      <div><span style="color:var(--muted)">Memory:</span> ${m.memory}</div>
+      <div><span style="color:var(--muted)">MTEB score:</span> <span class="tag ${m.mteb >= 65 ? 'good' : m.mteb >= 63 ? 'warn' : 'bad'}">${m.mteb}</span></div>
+      <div style="margin-top:12px"><span style="color:var(--muted)">使用场景:</span> ${m.best}</div>
+      <div style="margin-top:12px;padding:10px;background:var(--surface2);border-radius:6px;font-family:Consolas,monospace;font-size:11px">
+        <div style="color:var(--muted)">Python 调用:</div>
+        <div style="color:var(--green)">from sentence_transformers import SentenceTransformer</div>
+        <div style="color:var(--green)">model = SentenceTransformer("${m.full}")</div>
+        <div style="color:var(--green)">vec = model.encode(["text"])</div>
+      </div>
+    </div>
+  `;
+}
+
+// ========== Tab 1: Embedding Process ==========
+function setEmbedInput(text) { document.getElementById('embedInput').value = text; }
+
+function runEmbedding() {
+  const text = document.getElementById('embedInput').value.trim();
+  if (!text) return;
+
+  const vec = generateSimEmbedding(text, 8);
+  const model = MODELS[0]; // Default MiniLM
+
+  // Pipeline visualization
+  const tokens = text.split(/\s+/).slice(0, 8);
+  document.getElementById('pipeInput').textContent = text.length > 20 ? text.slice(0, 20) + '...' : text;
+  document.getElementById('pipeTokens').textContent = `[${tokens.length}] ${tokens.slice(0, 4).join(', ')}${tokens.length > 4 ? '...' : ''}`;
+  document.getElementById('pipeOutput').textContent = `${model.dim}-d vector`;
+
+  // Show vector
+  const displayVec = vec.map(v => v.toFixed(4));
+  document.getElementById('embedResult').innerHTML = `
+    <div class="grid-2">
+      <div>
+        <div style="font-size:12px;color:var(--muted);margin-bottom:6px">Generated Embedding (simulated 8D, real model outputs ${model.dim}D)</div>
+        <div class="vector-display">
+          <span class="dim-label">[</span>${displayVec.map((v, i) => {
+            const color = parseFloat(v) > 0 ? 'var(--accent)' : 'var(--red)';
+            return `<span style="color:${color}" title="dim_${i}">${v}</span>`;
+          }).join(', ')}<span class="dim-label">]</span>
+        </div>
+        <div style="margin-top:12px">
+          <div style="font-size:12px;color:var(--muted);margin-bottom:6px">Dimension Heatmap</div>
+          <div class="dim-vis">
+            ${vec.map((v, i) => {
+              const intensity = Math.abs(v);
+              const color = v > 0 ? `rgba(56,189,248,${0.2 + intensity * 0.8})` : `rgba(248,113,113,${0.2 + intensity * 0.8})`;
+              return `<div class="dim" style="background:${color};height:${12 + intensity * 28}px" title="dim_${i}: ${v.toFixed(4)}"></div>`;
+            }).join('')}
+          </div>
+        </div>
+      </div>
+      <div>
+        <div style="font-size:12px;color:var(--muted);margin-bottom:6px">向量属性</div>
+        <div style="font-size:13px;line-height:2">
+          <div>📏 L2 Norm: <span style="color:var(--accent)">${Math.sqrt(vec.reduce((s,v)=>s+v*v,0)).toFixed(4)}</span></div>
+          <div>📊 Max value: <span style="color:var(--green)">${Math.max(...vec).toFixed(4)}</span></div>
+          <div>📉 Min value: <span style="color:var(--red)">${Math.min(...vec).toFixed(4)}</span></div>
+          <div>🔢 Dimensions: <span style="color:var(--yellow)">${model.dim}</span> (simulated: 8)</div>
+          <div>⚡ Model: <span style="color:var(--purple)">${model.name}</span></div>
+        </div>
+        <div style="margin-top:12px;padding:10px;background:var(--surface2);border-radius:6px;font-size:11px;line-height:1.6">
+          <div style="color:var(--muted)">Embedding 的关键特性:</div>
+          <div>✅ 语义相似的文本 → 向量距离近</div>
+          <div>✅ 固定维度 (不随文本长度变化)</div>
+          <div>✅ 归一化后内积 = 余弦相似度</div>
+          <div>⚠️ 不同模型的向量空间不兼容</div>
+        </div>
+      </div>
+    </div>
+  `;
+}
+
+// ========== Tab 2: Similarity ==========
+function setSimTexts(a, b) {
+  document.getElementById('simTextA').value = a;
+  document.getElementById('simTextB').value = b;
+}
+
+function runSimilarity() {
+  const textA = document.getElementById('simTextA').value.trim();
+  const textB = document.getElementById('simTextB').value.trim();
+  if (!textA || !textB) return;
+
+  const embA = generateSimEmbedding(textA);
+  const embB = generateSimEmbedding(textB);
+  const sim = cosineSim(embA, embB);
+
+  // Build comparison pairs
+  const pairs = [
+    { a: textA, b: textB, label: '当前对比' },
+    { a: textA, b: textA, label: '完全相同' },
+    { a: 'The cat sits on the mat', b: 'A cat is sitting on a mat', label: '同义句 (预设)' },
+    { a: 'The cat sits on the mat', b: 'Dogs are playing outside', label: '不相关 (预设)' },
+    { a: 'How does photosynthesis work?', b: 'What is the process of photosynthesis?', label: '问句相似 (预设)' },
+  ];
+
+  const simScores = pairs.map(p => {
+    const ea = generateSimEmbedding(p.a);
+    const eb = generateSimEmbedding(p.b);
+    return { ...p, score: cosineSim(ea, eb) };
+  });
+
+  const scoreColor = sim > 0.7 ? 'var(--green)' : sim > 0.3 ? 'var(--yellow)' : 'var(--red)';
+  const scoreLabel = sim > 0.7 ? '高度相似' : sim > 0.3 ? '中等相似' : '不太相似';
+
+  document.getElementById('simResult').innerHTML = `
+    <div style="text-align:center;padding:20px;background:var(--surface2);border-radius:10px">
+      <div style="font-size:48px;font-weight:700;color:${scoreColor}">${sim.toFixed(4)}</div>
+      <div style="font-size:14px;color:${scoreColor};margin-top:4px">${scoreLabel}</div>
+      <div style="font-size:11px;color:var(--muted);margin-top:8px">Cosine Similarity = A·B / (|A|×|B|)</div>
+    </div>
+    <div class="grid-2" style="margin-top:12px">
+      <div>
+        <div style="font-size:12px;color:var(--muted);margin-bottom:4px">Vector A (20 dims shown)</div>
+        <div class="dim-vis">${embA.slice(0, 20).map(v => {
+          const c = v > 0 ? `rgba(56,189,248,${0.3+Math.abs(v)*0.7})` : `rgba(248,113,113,${0.3+Math.abs(v)*0.7})`;
+          return `<div class="dim" style="background:${c};height:${10+Math.abs(v)*20}px"></div>`;
+        }).join('')}</div>
+      </div>
+      <div>
+        <div style="font-size:12px;color:var(--muted);margin-bottom:4px">Vector B (20 dims shown)</div>
+        <div class="dim-vis">${embB.slice(0, 20).map(v => {
+          const c = v > 0 ? `rgba(74,222,128,${0.3+Math.abs(v)*0.7})` : `rgba(251,146,60,${0.3+Math.abs(v)*0.7})`;
+          return `<div class="dim" style="background:${c};height:${10+Math.abs(v)*20}px"></div>`;
+        }).join('')}</div>
+      </div>
+    </div>
+  `;
+
+  document.getElementById('simTable').innerHTML = `
+    <table class="comparison-table">
+      <thead><tr><th>对比</th><th>文本 A</th><th>文本 B</th><th>Score</th><th>判定</th></tr></thead>
+      <tbody>
+        ${simScores.map(p => {
+          const c = p.score > 0.7 ? 'good' : p.score > 0.3 ? 'warn' : 'bad';
+          const label = p.score > 0.7 ? '相似' : p.score > 0.3 ? '一般' : '无关';
+          return `<tr>
+            <td style="color:var(--muted)">${p.label}</td>
+            <td style="font-size:12px">${p.a.length > 30 ? p.a.slice(0, 30) + '...' : p.a}</td>
+            <td style="font-size:12px">${p.b.length > 30 ? p.b.slice(0, 30) + '...' : p.b}</td>
+            <td style="font-weight:600">${p.score.toFixed(4)}</td>
+            <td><span class="tag ${c}">${label}</span></td>
+          </tr>`;
+        }).join('')}
+      </tbody>
+    </table>
+  `;
+}
+
+// ========== Tab 3: Search ==========
+function runSearch() {
+  const query = document.getElementById('searchQuery').value.trim();
+  const topK = +document.getElementById('topK').value || 5;
+  if (!query) return;
+
+  const qEmb = generateSimEmbedding(query);
+  const results = CORPUS_EMB.map(d => ({
+    ...d,
+    score: cosineSim(qEmb, d.embedding)
+  })).sort((a, b) => b.score - a.score).slice(0, topK);
+
+  const maxScore = results[0]?.score || 1;
+
+  document.getElementById('searchResults').innerHTML = `
+    <div style="font-size:12px;color:var(--muted);margin-bottom:8px">Query: "${query}" → ${results.length} results (FAISS IndexFlatIP + L2 normalization)</div>
+    ${results.map((r, i) => {
+      const pct = Math.max((r.score / maxScore) * 100, 5);
+      const color = r.score > 0.7 ? 'var(--green)' : r.score > 0.4 ? 'var(--yellow)' : 'var(--orange)';
+      return `<div class="search-result" style="border-left-color:${color}">
+        <div style="display:flex;justify-content:space-between;align-items:center">
