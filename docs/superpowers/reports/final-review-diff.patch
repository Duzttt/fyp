+      </div>
+
+      <div v-if="durationRatio > 0" class="duration-track" aria-hidden="true">
+        <span class="duration-fill" :style="{ width: `${durationRatio * 100}%` }" />
+      </div>
+
+      <p class="stage-summary">{{ stage.summary }}</p>
+
+      <div v-if="results.length" class="stage-results">
