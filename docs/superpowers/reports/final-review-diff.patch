+        "id": "lecture3_chunk1",
+        "text": "Unsupervised learning algorithms discover hidden patterns or data groupings without the need for human intervention or labeled data.",
+        "source": "lecture3.pdf",
+        "metadata": {"page": 1, "heading": "Unsupervised Learning"}
